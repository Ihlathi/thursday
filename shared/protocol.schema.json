{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://adaptive-agent.local/protocol/1.0",
 "title": "Adaptive Agent protocol v1.0",
 "$defs": {
  "Bounds": {
   "type": "object",
   "properties": {
    "x": {
     "type": "number"
    },
    "y": {
     "type": "number"
    },
    "width": {
     "type": "number",
     "minimum": 0
    },
    "height": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "x",
    "y",
    "width",
    "height"
   ],
   "additionalProperties": false
  },
  "Error": {
   "type": "object",
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "message": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "retryable": {
     "type": "boolean"
    }
   },
   "required": [
    "code",
    "message",
    "retryable"
   ],
   "additionalProperties": false
  },
  "UIElement": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "role": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "name": {
     "type": "string",
     "maxLength": 1024
    },
    "description": {
     "type": "string",
     "maxLength": 2048
    },
    "bounds": {
     "type": "object",
     "properties": {
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      },
      "width": {
       "type": "number",
       "minimum": 0
      },
      "height": {
       "type": "number",
       "minimum": 0
      }
     },
     "required": [
      "x",
      "y",
      "width",
      "height"
     ],
     "additionalProperties": false
    },
    "enabled": {
     "type": "boolean"
    },
    "visible": {
     "type": "boolean"
    },
    "parent": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{1,100}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "children": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
     },
     "maxItems": 2000
    },
    "source": {
     "type": "string",
     "enum": [
      "accessibility",
      "api",
      "vision",
      "mock"
     ]
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "sensitive": {
     "type": "boolean"
    },
    "action_kind": {
     "type": "string",
     "enum": [
      "navigation",
      "edit",
      "submit",
      "delete",
      "security",
      "unknown"
     ]
    }
   },
   "required": [
    "id",
    "role",
    "name",
    "description",
    "bounds",
    "enabled",
    "visible",
    "parent",
    "children",
    "source",
    "confidence",
    "sensitive",
    "action_kind"
   ],
   "additionalProperties": false
  },
  "SystemState": {
   "type": "object",
   "properties": {
    "active_app": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "active_window": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "locked": {
     "type": "boolean"
    },
    "sleep_epoch": {
     "type": "integer",
     "minimum": 0
    },
    "revision": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "active_app",
    "active_window",
    "locked",
    "sleep_epoch",
    "revision"
   ],
   "additionalProperties": false
  },
  "StateDelta": {
   "type": "object",
   "properties": {
    "revision": {
     "type": "integer",
     "minimum": 0
    },
    "system": {
     "$ref": "#/$defs/SystemState"
    },
    "elements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/UIElement"
     },
     "maxItems": 2000
    },
    "removed_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
     },
     "maxItems": 2000
    },
    "full": {
     "type": "boolean"
    }
   },
   "required": [
    "revision"
   ],
   "additionalProperties": false
  },
  "Image": {
   "type": "object",
   "properties": {
    "mime_type": {
     "type": "string",
     "enum": [
      "image/png",
      "image/jpeg"
     ]
    },
    "data": {
     "type": "string",
     "maxLength": 2800000
    },
    "scope": {
     "type": "string",
     "enum": [
      "region",
      "screen"
     ]
    },
    "bounds": {
     "type": "object",
     "properties": {
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      },
      "width": {
       "type": "number",
       "minimum": 0
      },
      "height": {
       "type": "number",
       "minimum": 0
      }
     },
     "required": [
      "x",
      "y",
      "width",
      "height"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "mime_type",
    "data",
    "scope"
   ],
   "additionalProperties": false
  },
  "Audio": {
   "type": "object",
   "properties": {
    "mime_type": {
     "type": "string",
     "enum": [
      "audio/wav",
      "audio/mpeg",
      "audio/webm",
      "audio/ogg"
     ]
    },
    "encoding": {
     "const": "base64"
    },
    "data": {
     "type": "string",
     "minLength": 1,
     "maxLength": 2800000
    }
   },
   "required": [
    "mime_type",
    "encoding",
    "data"
   ],
   "additionalProperties": false
  },
  "ToolCall": {
   "type": "object",
   "properties": {
    "call_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "name": {
     "type": "string",
     "enum": [
      "get_system_state",
      "get_ui_state",
      "open_app",
      "open_url",
      "set_setting",
      "search_ui",
      "inspect_ui",
      "invoke_ui",
      "set_ui_value",
      "scroll",
      "move_mouse",
      "click",
      "type_text",
      "press_key",
      "inspect_screen",
      "inspect_region",
      "open_file",
      "open_folder",
      "run_approved_action",
      "propose_command",
      "ask_user",
      "request_confirmation",
      "complete_task"
     ]
    },
    "arguments": {
     "type": "object"
    },
    "expected_revision": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "call_id",
    "name",
    "arguments"
   ],
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "name": {
        "const": "get_system_state"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "get_ui_state"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "open_app"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "name"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "open_url"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "url"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "set_setting"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "setting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         },
         "value": {
          "type": [
           "string",
           "number",
           "boolean"
          ]
         }
        },
        "required": [
         "setting",
         "value"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "search_ui"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "query"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "inspect_ui"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
         }
        },
        "required": [
         "id"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "invoke_ui"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
         },
         "mode": {
          "type": "string",
          "enum": [
           "direct",
           "visible"
          ]
         }
        },
        "required": [
         "id",
         "mode"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "set_ui_value"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
         },
         "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "id",
         "value"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "scroll"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "direction": {
          "type": "string",
          "enum": [
           "up",
           "down",
           "left",
           "right"
          ]
         },
         "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
         }
        },
        "required": [
         "direction",
         "amount"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "move_mouse"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         }
        },
        "required": [
         "x",
         "y"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "click"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         }
        },
        "required": [
         "x",
         "y"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "type_text"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "text"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "press_key"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "key"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "inspect_screen"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "inspect_region"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "bounds": {
          "type": "object",
          "properties": {
           "x": {
            "type": "number"
           },
           "y": {
            "type": "number"
           },
           "width": {
            "type": "number",
            "minimum": 0
           },
           "height": {
            "type": "number",
            "minimum": 0
           }
          },
          "required": [
           "x",
           "y",
           "width",
           "height"
          ],
          "additionalProperties": false
         }
        },
        "required": [
         "bounds"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "open_file"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "path"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "open_folder"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "path"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "run_approved_action"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "action": {
          "type": "string",
          "enum": [
           "set_volume",
           "set_brightness"
          ]
         },
         "args": {
          "type": "object",
          "properties": {
           "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
           }
          },
          "required": [
           "value"
          ],
          "additionalProperties": false
         }
        },
        "required": [
         "action",
         "args"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "propose_command"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         },
         "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "command",
         "reason"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "ask_user"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "message"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "request_confirmation"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         },
         "consequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "action",
         "consequence"
        ],
        "additionalProperties": false
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "name": {
        "const": "complete_task"
       }
      }
     },
     "then": {
      "properties": {
       "arguments": {
        "type": "object",
        "properties": {
         "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
         }
        },
        "required": [
         "message"
        ],
        "additionalProperties": false
       }
      }
     }
    }
   ]
  },
  "ToolResult": {
   "type": "object",
   "properties": {
    "call_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "ok": {
     "type": "boolean"
    },
    "data": {
     "type": "object"
    },
    "delta": {
     "$ref": "#/$defs/StateDelta"
    },
    "image": {
     "$ref": "#/$defs/Image"
    },
    "error": {
     "$ref": "#/$defs/Error"
    }
   },
   "required": [
    "call_id",
    "ok"
   ],
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "ok": {
        "const": false
       }
      }
     },
     "then": {
      "required": [
       "error"
      ]
     }
    }
   ]
  },
  "ConfirmationRequest": {
   "type": "object",
   "properties": {
    "confirmation_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "call_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "action_hash": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "action": {
     "type": "string",
     "minLength": 1,
     "maxLength": 16384
    },
    "consequence": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "risk": {
     "type": "string",
     "enum": [
      "READ_ONLY",
      "REVERSIBLE",
      "CONSEQUENTIAL",
      "DESTRUCTIVE",
      "SECURITY_SENSITIVE"
     ]
    },
    "expires_at": {
     "type": "number"
    }
   },
   "required": [
    "confirmation_id",
    "call_id",
    "action_hash",
    "action",
    "consequence",
    "risk",
    "expires_at"
   ],
   "additionalProperties": false
  },
  "ConfirmationResponse": {
   "type": "object",
   "properties": {
    "confirmation_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "call_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "action_hash": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "approved": {
     "type": "boolean"
    }
   },
   "required": [
    "confirmation_id",
    "call_id",
    "action_hash",
    "approved"
   ],
   "additionalProperties": false
  },
  "UserRequest": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string",
     "minLength": 1,
     "maxLength": 4096
    },
    "audio": {
     "$ref": "#/$defs/Audio"
    },
    "speak": {
     "type": "boolean"
    }
   },
   "required": [],
   "additionalProperties": false,
   "oneOf": [
    {
     "required": [
      "text"
     ],
     "not": {
      "required": [
       "audio"
      ]
     }
    },
    {
     "required": [
      "audio"
     ],
     "not": {
      "required": [
       "text"
      ]
     }
    }
   ]
  },
  "AgentEvent": {
   "type": "object",
   "properties": {
